# ─────────────────────────────────────────────────────────────
# Variables de entorno de Los Rincones de Lúa
# Copia este archivo como .env.local para desarrollo (no se sube a git)
# y crea las mismas variables en Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL pública de la web, sin barra final (sitemap, Open Graph, canonical).
NEXT_PUBLIC_SITE_URL=https://www.losrinconesdelua.es

# ── Vercel Blob: fotos que suben las familias ── (OBLIGATORIA)
# Se crea sola al conectar un Blob Store al proyecto en Vercel (pestaña Storage).
# Para local: `vercel env pull .env.local` o cópiala del panel del Blob Store.
BLOB_READ_WRITE_TOKEN=

# ── Supabase: base de datos de clientes (tabla `leads`) ── (recomendada)
# Supabase → tu proyecto → Project Settings → API:
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = clave "service_role" (o la "secret key" sb_secret_…)
# ¡Es una clave secreta! Solo en Vercel/.env.local, nunca con prefijo NEXT_PUBLIC_.
# Antes del primer uso ejecuta supabase/schema.sql en el SQL Editor de Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend: aviso por email de cada solicitud ── (recomendada)
# API key en https://resend.com/api-keys
RESEND_API_KEY=
# Dónde llegan las solicitudes. Si lo dejas vacío se usa losrinconesdelua@gmail.com
# (definido en src/content/site.ts). Varios correos separados por comas.
LEAD_NOTIFICATION_EMAIL=losrinconesdelua@gmail.com
# Remitente. Sin dominio propio verificado en Resend usa el de pruebas:
#   Los Rincones de Lúa <onboarding@resend.dev>
# (con él Resend SOLO entrega al email con el que creaste la cuenta de Resend,
#  así que crea la cuenta con losrinconesdelua@gmail.com).
# Con dominio verificado: Los Rincones de Lúa <hola@losrinconesdelua.es>
EMAIL_FROM=Los Rincones de Lúa <onboarding@resend.dev>
# "true" para enviar también un email de confirmación a la familia (requiere dominio verificado).
SEND_CUSTOMER_CONFIRMATION=false
